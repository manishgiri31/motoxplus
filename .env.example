# =============================================================================
# MOTOXPLUS — ENVIRONMENT VARIABLES REFERENCE
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
#
# [REQUIRED] vars are checked at server boot (src/instrumentation.ts, backed by
# src/lib/env.ts) — the process logs exactly which ones are missing/placeholder
# and exits(1) rather than starting half-configured.
# [OPTIONAL] vars have working fallback behavior in code if left unset.
# =============================================================================

# =============================================================================
# DATABASE
# =============================================================================

# [REQUIRED] PostgreSQL connection string
# Production: use local socket for best performance
# Example (TCP): postgresql://user:password@localhost:5432/motoxplus
# Example (socket): postgresql://user:password@localhost/motoxplus?host=/var/run/postgresql
DATABASE_URL="postgresql://motoxplus:STRONG_PASSWORD_HERE@localhost:5432/motoxplus"

# =============================================================================
# NEXTAUTH
# =============================================================================

# [REQUIRED] Public URL of your application (no trailing slash)
NEXTAUTH_URL="https://motoxplus.com"

# [REQUIRED] Random 64-char secret — generate with: openssl rand -hex 32
NEXTAUTH_SECRET="replace_with_64_char_random_hex_string"

# =============================================================================
# JWT (custom auth sessions — separate from NextAuth; used by the mobile app
# and Bearer-token clients)
# =============================================================================

# [REQUIRED] Random 64-char secret — generate with: openssl rand -hex 32
# There is no fallback: an empty/missing value now fails the boot check
# instead of silently signing tokens with a hardcoded default.
JWT_SECRET="replace_with_64_char_random_hex_string"

# =============================================================================
# ENCRYPTION (used to encrypt dealer Aadhaar numbers at rest)
# =============================================================================

# [REQUIRED] 32 bytes, hex or base64 encoded — generate with: openssl rand -hex 32
ENCRYPTION_KEY="replace_with_32_byte_hex_or_base64_string"

# =============================================================================
# RAZORPAY PAYMENTS
# =============================================================================

# [OPTIONAL] Master switch for online payment (Full Payment / 20% Advance).
# Razorpay is not yet configured on the merchant account — leave this unset
# or "false" and only Direct UPI / Cash on Delivery are offered at checkout
# (both the UI and the order-creation endpoint enforce this, not just the UI).
# Set to "true" once onboarded — RAZORPAY_KEY_ID/SECRET and
# NEXT_PUBLIC_RAZORPAY_KEY_ID then become [REQUIRED] and the boot check will
# enforce that too. No code changes needed either way.
NEXT_PUBLIC_RAZORPAY_ENABLED="false"

# [REQUIRED only if NEXT_PUBLIC_RAZORPAY_ENABLED=true] https://dashboard.razorpay.com/app/keys
# Use rzp_test_* while testing, rzp_live_* in production — never commit either.
RAZORPAY_KEY_ID="rzp_test_XXXXXXXXXXXX"
RAZORPAY_KEY_SECRET="XXXXXXXXXXXXXXXXXXXX"

# [REQUIRED only if NEXT_PUBLIC_RAZORPAY_ENABLED=true] Same key exposed to the
# browser (only key_id, NEVER key_secret — the secret must stay server-only).
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_XXXXXXXXXXXX"

# =============================================================================
# CLOUDFLARE R2 STORAGE
# =============================================================================

# [REQUIRED] Found in Cloudflare dashboard → R2 → Manage R2 API tokens
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="motoxplus-assets"

# [REQUIRED] Public R2 bucket URL (enable public access on the R2 bucket first)
R2_PUBLIC_URL="https://pub-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.r2.dev"

# =============================================================================
# EMAIL — RESEND
# =============================================================================

# [REQUIRED] Get from https://resend.com/api-keys
RESEND_API_KEY="re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# [REQUIRED] Verified sender email (must be verified in Resend dashboard)
EMAIL_FROM="noreply@motoxplus.in"

# [OPTIONAL] Inbox that receives website contact-form enquiries — falls back
# to NEXT_PUBLIC_COMPANY_EMAIL, then EMAIL_FROM, if unset.
CONTACT_EMAIL="info@motoxplus.in"

# [OPTIONAL] Inbox notified when a dealer submits a UPI/bank-transfer payment
# for manual verification — falls back to a hardcoded "accounts@motoxplus.in"
# in src/app/api/payments/upi/submit/route.ts if unset. Set this explicitly
# if that inbox is wrong/stale so payments notifications don't go missing.
ACCOUNTS_EMAIL="accounts@motoxplus.in"

# =============================================================================
# SMS / OTP DELIVERY
# =============================================================================

# [OPTIONAL, defaults to "msg91"] Which provider sends OTP/SMS: "msg91" | "twilio" | "fast2sms"
# If the selected provider's credentials below are missing or placeholder,
# OTP codes are logged to the server console instead of sent (dev-safe
# fallback) — this must never happen in production.
SMS_PROVIDER="msg91"

# MSG91 credentials (used when SMS_PROVIDER=msg91) — https://msg91.com/
MSG91_AUTH_KEY="your_msg91_auth_key"
MSG91_SENDER_ID="MOTOXX"
MSG91_OTP_TEMPLATE_ID="your_msg91_otp_template_id"
MSG91_FLOW_ID="your_msg91_flow_id"

# Twilio credentials (used when SMS_PROVIDER=twilio) — https://www.twilio.com/
# TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_AUTH_TOKEN="your_twilio_auth_token"
# TWILIO_FROM_NUMBER="+1234567890"

# Fast2SMS credentials (used when SMS_PROVIDER=fast2sms) — https://www.fast2sms.com/
# FAST2SMS_API_KEY="your_fast2sms_api_key"

# =============================================================================
# DELHIVERY SHIPPING
# =============================================================================

# [OPTIONAL] Delhivery API token — get from the Delhivery partner portal.
# Shipment creation/tracking is skipped (logged, not thrown) if unset.
DELHIVERY_API_TOKEN="your_delhivery_api_token"
DELHIVERY_BASE_URL="https://track.delhivery.com"
DELHIVERY_ORIGIN_PINCODE="110046"

# [OPTIONAL, but fails closed] Webhook signature secret — if unset, the
# webhook endpoint rejects all requests in production (500/503) rather than
# skipping verification; only skipped for convenience in development.
# Generate: openssl rand -hex 32
DELHIVERY_WEBHOOK_SECRET="your_delhivery_webhook_secret"

# [OPTIONAL] Pickup address used when creating Delhivery shipments
DELHIVERY_PICKUP_NAME="MotoXPlus India Pvt. Ltd."
DELHIVERY_PICKUP_ADDRESS="Your pickup address"
DELHIVERY_PICKUP_CITY="New Delhi"
DELHIVERY_PICKUP_STATE="Delhi"
DELHIVERY_PICKUP_PHONE="9999999999"

# =============================================================================
# SHIPROCKET
# =============================================================================

# [OPTIONAL] Shiprocket account credentials — email+password auth, not an API
# key (see src/lib/shiprocket/auth.ts). Without both set, any code that calls
# getShiprocketToken()/shiprocketFetch() throws ShiprocketConfigError
# immediately — there is no silent skip/log-and-continue fallback.
SHIPROCKET_EMAIL="your_shiprocket_account_email"
SHIPROCKET_PASSWORD="your_shiprocket_account_password"

# [OPTIONAL, defaults to the value below] Shiprocket API base URL.
SHIPROCKET_API_URL="https://apiv2.shiprocket.in/v1/external"

# =============================================================================
# REDIS (distributed rate limiting; also caches the Shiprocket auth token)
# =============================================================================

# [OPTIONAL, but strongly recommended in production] Redis connection URL.
# Without it, rate limiting (login, OTP, registration, contact form) falls
# back to an in-process counter — under PM2 cluster mode (ecosystem.config.js
# runs `instances: "max"`, one worker per CPU core) each worker holds its own
# independent counter, so the *effective* limit is silently multiplied by the
# number of cores. Setting REDIS_URL shares one counter across all workers.
# Install: sudo apt install redis-server
REDIS_URL="redis://localhost:6379"

# =============================================================================
# APPLICATION
# =============================================================================

# [REQUIRED] Full public URL (used in emails, og:url, canonical tags)
NEXT_PUBLIC_APP_URL="https://motoxplus.com"

# [OPTIONAL] Company info displayed throughout the app (footer, contact page,
# WhatsApp chat link, invoices). NEXT_PUBLIC_COMPANY_NAME and
# NEXT_PUBLIC_COMPANY_WEBSITE are currently unused in code (nothing reads
# them) — kept here for reference/future use rather than removed outright.
NEXT_PUBLIC_COMPANY_NAME="MOTOXPLUS India Private Limited"
NEXT_PUBLIC_COMPANY_WHATSAPP="91 92171 31801"
NEXT_PUBLIC_COMPANY_GST="07AAUCM5765B1Z4"
NEXT_PUBLIC_COMPANY_ADDRESS="RZ-43/291, Street Number 6, Geetanjli Park, Sagarpur West, New Delhi, South West Delhi, Delhi, 110046"
NEXT_PUBLIC_COMPANY_PHONE="+91 92171 31801"
NEXT_PUBLIC_COMPANY_EMAIL="info@motoxplus.in"
NEXT_PUBLIC_COMPANY_WEBSITE="www.motoxplus.in"
